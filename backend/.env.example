APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Shared plain-text password of every seeded account (never a prod secret).
SEED_PASSWORD=Qualifica2026!
# Seeded accounts must replace that password at first access (spec 0177).
# Defaults to true, false when APP_ENV=staging; set it explicitly to override.
SEED_FORCE_PASSWORD_CHANGE=
# Production seed forces a password change on active users who never chose one
# (spec 0356). Defaults to true only when APP_ENV=production.
SEED_REQUIRE_PASSWORD_CHANGE=
# Users flagged for a password change are blocked until they choose one
# (spec 0359). Defaults to true only when APP_ENV=production.
AUTH_FIRST_ACCESS_GATE=
AUTH_ONBOARDING_VERSION=1

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
# Site-wide maintenance: comma-separated users.id keep working (spec 0376).
APP_MAINTENANCE_ENABLED=false
APP_MAINTENANCE_EXCLUDED_USER_IDS=

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=
# Max seconds a web/API request may run a query (MariaDB max_statement_time /
# MySQL max_execution_time). 0 = disabled. Keep it BELOW the PHP-FPM
# request_terminate_timeout. Import/export/report endpoints are exempt.
DB_STATEMENT_TIMEOUT_SECONDS=25

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb

# Laravel Reverb (spec 0352). Placeholders only: generate real values per environment.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Staging only: funnels EVERY email to this single mailbox (original to/cc/bcc
# dropped) and sends it FROM that mailbox too (original display name kept). Ignored when APP_ENV=production. Required when APP_ENV=staging:
# left empty there, every email is blocked. Elsewhere empty = deliver normally.
MAIL_ALWAYS_TO=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

TEAMS_WEBHOOK_ENABLED=false
TEAMS_WEBHOOK_ERRORS=""
TEAMS_WEBHOOK_INFO=""
FRONTEND_URL="http://localhost:5173"

# API token lifetime in minutes (default 43200 = 30 days).
SANCTUM_EXPIRATION=43200

# External data migration (spec 0013): base URL + Bearer token of the external
# system's read API. Never a real value here (see .env for the actual secret).
EXTERNAL_MIGRATION_BASE_URL=
EXTERNAL_MIGRATION_TOKEN=
EXTERNAL_MIGRATION_TIMEOUT=15
# Seconds a migration job may run before the worker kills it (run -> failed).
# Raise DB_QUEUE_RETRY_AFTER with it: it must stay above this value.
MIGRATION_JOB_TIMEOUT=1800
# Dedicated queue of the migration jobs, so a long migration never blocks the
# `default` queue. It needs its own worker: php artisan queue:work --queue=migrations
MIGRATION_QUEUE=migrations
# Dedicated queue of the file import jobs (analyze/stage/commit), same reason.
# It needs its own worker: php artisan queue:work --queue=imports
IMPORT_QUEUE=imports
# Spec 0285: true = the `users` source only links existing accounts (old_id).
EXTERNAL_MIGRATION_USERS_LINK_ONLY=false
# Spec 0295: base URL of the legacy files (tenant domain); link-only legacy
# documents are streamed only from URLs under it. Empty = feature off.
EXTERNAL_MIGRATION_FILES_BASE_URL=
EXTERNAL_MIGRATION_FILES_TIMEOUT=30

# Quote document / layout preview PDF conversion (config/documents.php): the
# headless LibreOffice binary that turns the rendered .docx into the delivered
# .pdf. PATH-resolvable name or absolute path — on macOS the cask installs it at
# /Applications/LibreOffice.app/Contents/MacOS/soffice.
LIBREOFFICE_BINARY=soffice
LIBREOFFICE_TIMEOUT=60

# National mode (config/geo.php): ISO 3166-1 alpha-2 code of the country the UI
# preselects on an empty geo cascade, and the one the parentless geo lookups
# (region for-select, city-first search) are filtered to. "IT" = Italy (still
# changeable); empty = international mode, nothing preselected.
DEFAULT_COUNTRY_ISO2=IT

# Work order emails (spec 0175, D-1): the mailer config/outbound_emails.php
# resolves to. Empty here falls back to 'microsoft-graph'; set to 'log' in
# local dev so no real M365 mailbox is needed. MAIL_MSGRAPH_* are the client-
# credentials of the microsoft-graph transport (never a real value here — see
# .env for the actual secret).
OUTBOUND_EMAIL_MAILER=
MAIL_MSGRAPH_TENANT=
MAIL_MSGRAPH_CLIENT=
MAIL_MSGRAPH_SECRET=

# Agent commission settlements (spec 0213, D-6): default minimum taxable amount
# below which a run skips an (agent, company) pair and carries it forward.
COMMISSION_SETTLEMENT_MIN_AMOUNT=0.00
COMMISSION_DOCUMENT_TOLERANCE=1.00

EXTERNAL_MIGRATION_USERS_LINK_ONLY=true

# Project work order chat (spec 0359, 0432, config/chat.php): false switches it off for the
# whole installation (API 404, no channels in the dock, no "Non letti" column).
CHAT_ENABLED=true
CHAT_EDIT_WINDOW_MINUTES=15

# AI assistant (spec 0347, 0433, config/ai-assistant.php). The agent runs in a queued job on the
# ai-assistant queue (one worker process per turn running at once). Keys and secrets are
# server-side only; never use a VITE_ prefix.
# Surfaces, both off by default: floating chat window and /ai-assistant page.
AI_ASSISTANT_FLOATING_ENABLED=false
AI_ASSISTANT_PAGE_ENABLED=false
# OpenRouter: the only model provider. Site URL and app name default to FRONTEND_URL / APP_NAME.
AI_ASSISTANT_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_ASSISTANT_OPENROUTER_API_KEY=
AI_ASSISTANT_OPENROUTER_SITE_URL=
AI_ASSISTANT_OPENROUTER_APP_NAME=
# Initial model of the settings row (the settings page replaces it): id "<vendor>/<model>". The routing
# (providers without data retention, every parameter required, fastest first) is fixed in config/ai-assistant.php.
AI_ASSISTANT_DEFAULT_MODEL=deepseek/deepseek-v4-flash-0731
# Initial monthly spending caps in dollars, company total and each person (the settings page changes them). Empty: no cap.
AI_ASSISTANT_DEFAULT_SPEND_CAP_TOTAL_USD=20
AI_ASSISTANT_DEFAULT_SPEND_CAP_PERSON_USD=5
# Caps per turn; the job timeout is derived from them and must stay under DB_QUEUE_RETRY_AFTER.
AI_ASSISTANT_AGENT_MAX_MODEL_CALLS=8
AI_ASSISTANT_AGENT_MAX_TOOL_CALLS=12
AI_ASSISTANT_AGENT_MAX_TURN_SECONDS=600
AI_ASSISTANT_AGENT_MAX_OUTPUT_TOKENS=4096
# Reasoning tokens limit sent to a model that reasons; always sent strictly under the output tokens.
AI_ASSISTANT_AGENT_REASONING_MAX_TOKENS=2048
# Turns not yet final one person may have at once, over all their conversations.
AI_ASSISTANT_AGENT_MAX_ACTIVE_TURNS_PER_USER=3
AI_ASSISTANT_AGENT_STALE_MARGIN_SECONDS=120
# Write preview: lifetime in seconds (the connector's is 10 minutes) and the margin kept under it.
AI_ASSISTANT_PREVIEW_TTL_SECONDS=600
AI_ASSISTANT_PREVIEW_MARGIN_SECONDS=5
AI_ASSISTANT_AGENT_POLL_INTERVAL_MS=1500
# Settings page: longest additional instructions, seconds of cache and timeout of the OpenRouter catalogue.
AI_ASSISTANT_INSTRUCTIONS_MAX_CHARS=8000
AI_ASSISTANT_MODELS_CACHE_SECONDS=300
AI_ASSISTANT_CATALOG_TIMEOUT_SECONDS=10
# Cost reservation: token margin of the chat format, minutes after which an open reservation is dropped, longest report period in days.
AI_ASSISTANT_COST_INPUT_MARGIN_TOKENS=1000
AI_ASSISTANT_COST_RESERVATION_TTL_MINUTES=30
AI_ASSISTANT_COST_REPORT_MAX_DAYS=366
# Connector entry of the assistant: URL QNET2 reaches it on (127.0.0.1 in production), the public host
# the connector accepts in the Host header, and the secret shared with the connector (ASSISTANT_SECRET there).
AI_ASSISTANT_CONNECTOR_URL=http://127.0.0.1:3000
AI_ASSISTANT_CONNECTOR_HOST=
AI_ASSISTANT_CONNECTOR_SECRET=
AI_ASSISTANT_CONNECTOR_TIMEOUT_SECONDS=90
AI_ASSISTANT_CONNECTOR_CONNECT_TIMEOUT_SECONDS=5
AI_ASSISTANT_TIMEOUT_SECONDS=120
AI_ASSISTANT_CONNECT_TIMEOUT_SECONDS=10
AI_ASSISTANT_MAX_MESSAGE_CHARS=8000
AI_ASSISTANT_GUIDE_MAX_CHARS=40000
AI_ASSISTANT_MAX_MENTIONS=5
AI_ASSISTANT_SUMMARY_THRESHOLD_PERCENT=70
AI_ASSISTANT_KEEP_RECENT_TURNS=2
AI_ASSISTANT_MAX_SUMMARIES=3
AI_ASSISTANT_SUMMARY_MAX_WORDS=300
AI_ASSISTANT_BYTES_PER_TOKEN=2.0
AI_ASSISTANT_FALLBACK_CONTEXT_TOKENS=32000
AI_ASSISTANT_MAX_FILES=4
AI_ASSISTANT_MAX_FILE_SIZE_KB=10240
AI_ASSISTANT_ACCEPTED_MIMES=application/pdf,image/png,image/jpeg,image/webp
AI_ASSISTANT_RETENTION_DAYS=30

# Formalab integration (spec 0422). Disabled by default: when false nothing about
# Formalab exists in the app. After changing it run `php artisan config:cache`.
FORMALAB_ENABLED=false
FORMALAB_URL=
FORMALAB_USER_EMAIL=
FORMALAB_USER_PASSWORD=
FORMALAB_INBOUND_TOKEN=
FORMALAB_TIMEOUT_SECONDS=30
FORMALAB_HEALTH_TIMEOUT_SECONDS=5
FORMALAB_TOKEN_TTL_MINUTES=1440
FORMALAB_SYNC_INTERVAL_MINUTES=60
FORMALAB_LOG_RETENTION_DAYS=90

# MCP link module: days of life of a link credential and minutes of a user token issued by an exchange.
MCP_LINK_TTL_DAYS=365
MCP_LINK_ACCESS_TOKEN_TTL_MINUTES=60
# MCP link module: failed openings before the route answers 429, per address and per API client, and minutes before a counter decays.
MCP_LINK_OPEN_MAX_ATTEMPTS=5
MCP_LINK_OPEN_CLIENT_MAX_ATTEMPTS=50
MCP_LINK_OPEN_DECAY_MINUTES=15
# MCP link module: commit of QNET2 in service, returned by the link exchange. Required, set at every release: unset, the exchange fails.
MCP_LINK_RELEASE_COMMIT=
# MCP link module: id of the connector's API client that the AI assistant links are opened for (spec 0433). Unset: the assistant cannot open a link.
MCP_LINK_ASSISTANT_CLIENT_ID=
