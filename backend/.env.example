APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Shared plain-text password of every seeded account (never a prod secret).
SEED_PASSWORD=Qualifica2026!
# Seeded accounts must replace that password at first access (spec 0177).
# Defaults to true, false when APP_ENV=staging; set it explicitly to override.
SEED_FORCE_PASSWORD_CHANGE=
# Production seed forces a password change on active users who never chose one
# (spec 0356). Defaults to true only when APP_ENV=production.
SEED_REQUIRE_PASSWORD_CHANGE=
# Users flagged for a password change are blocked until they choose one
# (spec 0359). Defaults to true only when APP_ENV=production.
AUTH_FIRST_ACCESS_GATE=
AUTH_ONBOARDING_VERSION=1

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=
# Max seconds a web/API request may run a query (MariaDB max_statement_time /
# MySQL max_execution_time). 0 = disabled. Keep it BELOW the PHP-FPM
# request_terminate_timeout. Import/export/report endpoints are exempt.
DB_STATEMENT_TIMEOUT_SECONDS=25

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb

# Laravel Reverb (spec 0352). Placeholders only: generate real values per environment.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Staging only: funnels EVERY email to this single mailbox (original to/cc/bcc
# dropped) and sends it FROM that mailbox too (original display name kept). Ignored when APP_ENV=production. Required when APP_ENV=staging:
# left empty there, every email is blocked. Elsewhere empty = deliver normally.
MAIL_ALWAYS_TO=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

TEAMS_WEBHOOK_ENABLED=false
TEAMS_WEBHOOK_ERRORS=""
TEAMS_WEBHOOK_INFO=""
FRONTEND_URL="http://localhost:5173"

# API token lifetime in minutes (default 43200 = 30 days).
SANCTUM_EXPIRATION=43200

# External data migration (spec 0013): base URL + Bearer token of the external
# system's read API. Never a real value here (see .env for the actual secret).
EXTERNAL_MIGRATION_BASE_URL=
EXTERNAL_MIGRATION_TOKEN=
EXTERNAL_MIGRATION_TIMEOUT=15
# Seconds a migration job may run before the worker kills it (run -> failed).
# Raise DB_QUEUE_RETRY_AFTER with it: it must stay above this value.
MIGRATION_JOB_TIMEOUT=1800
# Dedicated queue of the migration jobs, so a long migration never blocks the
# `default` queue. It needs its own worker: php artisan queue:work --queue=migrations
MIGRATION_QUEUE=migrations
# Spec 0285: true = the `users` source only links existing accounts (old_id).
EXTERNAL_MIGRATION_USERS_LINK_ONLY=false
# Spec 0295: base URL of the legacy files (tenant domain); link-only legacy
# documents are streamed only from URLs under it. Empty = feature off.
EXTERNAL_MIGRATION_FILES_BASE_URL=
EXTERNAL_MIGRATION_FILES_TIMEOUT=30

# Quote document / layout preview PDF conversion (config/documents.php): the
# headless LibreOffice binary that turns the rendered .docx into the delivered
# .pdf. PATH-resolvable name or absolute path — on macOS the cask installs it at
# /Applications/LibreOffice.app/Contents/MacOS/soffice.
LIBREOFFICE_BINARY=soffice
LIBREOFFICE_TIMEOUT=60

# National mode (config/geo.php): ISO 3166-1 alpha-2 code of the country the UI
# preselects on an empty geo cascade, and the one the parentless geo lookups
# (region for-select, city-first search) are filtered to. "IT" = Italy (still
# changeable); empty = international mode, nothing preselected.
DEFAULT_COUNTRY_ISO2=IT

# Work order emails (spec 0175, D-1): the mailer config/outbound_emails.php
# resolves to. Empty here falls back to 'microsoft-graph'; set to 'log' in
# local dev so no real M365 mailbox is needed. MAIL_MSGRAPH_* are the client-
# credentials of the microsoft-graph transport (never a real value here — see
# .env for the actual secret).
OUTBOUND_EMAIL_MAILER=
MAIL_MSGRAPH_TENANT=
MAIL_MSGRAPH_CLIENT=
MAIL_MSGRAPH_SECRET=

# Agent commission settlements (spec 0213, D-6): default minimum taxable amount
# below which a run skips an (agent, company) pair and carries it forward.
COMMISSION_SETTLEMENT_MIN_AMOUNT=0.00
COMMISSION_DOCUMENT_TOLERANCE=1.00

EXTERNAL_MIGRATION_USERS_LINK_ONLY=true

NAVIGATION_PROJECT_WORK_ORDERS_ENABLED=false

# AI assistant (spec 0347, config/ai-assistant.php): driver = openai | anthropic
# (empty = not configured). Keys are server-side only; never use a VITE_ prefix.
# Local LLM (LM Studio, Ollama...): driver openai, no key, e.g.
#   AI_ASSISTANT_OPENAI_BASE_URL=http://127.0.0.1:1234/v1   (Ollama: http://127.0.0.1:11434/v1)
#   AI_ASSISTANT_OPENAI_MODEL=google/gemma-4-e2b             (the id listed by GET /v1/models)
#   AI_ASSISTANT_ACCEPTED_MIMES=image/png,image/jpeg,image/webp   (LM Studio rejects PDFs)
#   AI_ASSISTANT_MAX_FILES=0                                  (model without vision: no attachments)
# Surfaces, both off by default: floating chat window and /ai-assistant page.
AI_ASSISTANT_FLOATING_ENABLED=false
AI_ASSISTANT_PAGE_ENABLED=false
AI_ASSISTANT_DRIVER=
AI_ASSISTANT_OPENAI_BASE_URL=https://api.openai.com/v1
AI_ASSISTANT_OPENAI_API_KEY=
AI_ASSISTANT_OPENAI_MODEL=gpt-4.1-mini
AI_ASSISTANT_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
AI_ASSISTANT_ANTHROPIC_API_KEY=
AI_ASSISTANT_ANTHROPIC_MODEL=claude-sonnet-5-5
AI_ASSISTANT_ANTHROPIC_VERSION=2023-06-01
AI_ASSISTANT_MAX_OUTPUT_TOKENS=2048
AI_ASSISTANT_TEMPERATURE=
AI_ASSISTANT_TIMEOUT_SECONDS=120
AI_ASSISTANT_CONNECT_TIMEOUT_SECONDS=10
AI_ASSISTANT_HISTORY_WINDOW=20
AI_ASSISTANT_MAX_MESSAGE_CHARS=8000
AI_ASSISTANT_GUIDE_MAX_CHARS=40000
AI_ASSISTANT_MAX_MENTIONS=5
AI_ASSISTANT_MENTION_MAX_CHARS=8000
AI_ASSISTANT_MAX_FILES=4
AI_ASSISTANT_MAX_FILE_SIZE_KB=10240
AI_ASSISTANT_ACCEPTED_MIMES=application/pdf,image/png,image/jpeg,image/webp
AI_ASSISTANT_RETENTION_DAYS=30
